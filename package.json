{
  "name": "besakih-people-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal SDM dan Keamanan BP Besakih",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "init": "node --env-file-if-exists=.env scripts/init.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  }
}
